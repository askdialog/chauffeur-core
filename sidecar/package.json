{
  "name": "@chauffeur/sidecar",
  "version": "0.37.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "start": "bun run src/main.ts",
    "test": "bun test",
    "test:e2e": "bun run build && CHAUFFEUR_SIDECAR_E2E=1 bun test test/e2e.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "bun scripts/build.ts",
    "gen:codex": "rm -rf src/agents/codex/generated && codex app-server generate-ts --out src/agents/codex/generated && codex --version"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.322",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@types/bun": "1.4.4",
    "typescript": "7.0.2",
    "zod": "4.6.7"
  }
}
