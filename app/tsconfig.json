{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": [
      "bun",
      "vite/client"
    ],
    "paths": {
      "@chauffeur/protocol": [
        "../protocol-ts/src/index.ts"
      ],
      "@/*": [
        "./src/*"
      ],
      "@chauffeur/core/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "src",
    "sdk",
    "vite.config.ts",
    "../protocol-ts/src"
  ]
}
