{
  "name": "@chauffeur/relay",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "postinstall": "bun install --cwd ../packages/remote --frozen-lockfile",
    "start": "bun src/main.ts",
    "pair": "bun src/pair.ts",
    "test:phone": "bun src/phone-test.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "mobile:host": "bun src/phone-test.ts --daemon",
    "build:host": "bun build src/host.ts --compile --outfile dist/chauffeur-mobile-host"
  },
  "dependencies": {
    "@chauffeur/protocol": "file:../protocol-ts",
    "@chauffeur/remote": "file:../packages/remote",
    "qrcode": "1.5.4",
    "qrcode-terminal": "0.12.0",
    "ws": "^8.22.1",
    "ws-unix": "npm:ws@8.22.0"
  },
  "devDependencies": {
    "@types/bun": "1.4.3",
    "@types/qrcode": "1.5.6",
    "@types/qrcode-terminal": "0.12.2",
    "@types/ws": "^8.18.2",
    "typescript": "~6.0.3"
  }
}
