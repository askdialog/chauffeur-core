{
  "display_information": {
    "name": "Chauffeur"
  },
  "features": {
    "bot_user": {
      "display_name": "Chauffeur",
      "always_online": false
    },
    "shortcuts": [
      {
        "name": "Ouvrir dans Chauffeur",
        "type": "message",
        "callback_id": "chauffeur_open",
        "description": "Pr\u00e9remplir une nouvelle session locale avec ce message ou son fil."
      }
    ]
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "commands",
        "channels:history",
        "groups:history"
      ]
    },
    "redirect_urls": [
      "https://YOUR-SERVICE-HOST/slack/auth/callback"
    ]
  },
  "settings": {
    "interactivity": {
      "is_enabled": true,
      "request_url": "https://YOUR-SERVICE-HOST/slack/actions"
    },
    "socket_mode_enabled": false
  }
}
